---
interface Props {
  copy: {
    cta: { text_cn: string; text_en: string };
  };
}
const { copy } = Astro.props;
---

<section class="reveal py-20 text-center rounded-3xl overflow-hidden relative" style="background: #1f262e;">
  <div class="relative z-10 space-y-8 max-w-2xl mx-auto px-6">
    <h2 class="display-lg" style="color: #ffffff;">
      <span class="i18n-cn">翻开每一个版本</span>
      <span class="i18n-en">Flip Through Every Release</span>
    </h2>
    <p class="title-lg" style="color: rgba(255,255,255,0.65);">
      <span class="i18n-cn">{copy.cta.text_cn}</span>
      <span class="i18n-en">{copy.cta.text_en}</span>
    </p>
    <a
      class="inline-flex items-center gap-4 px-12 py-5 rounded-full font-bold font-headline hover:scale-95 transition-all shadow-xl"
      style="background: #ffffff; color: #1f262e;"
      href="/explore"
    >
      <span class="i18n-cn">进入版本归档</span>
      <span class="i18n-en">OPEN THE ARCHIVE</span>
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
  </div>
</section>
